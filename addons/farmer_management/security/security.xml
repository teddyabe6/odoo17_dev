<odoo>
    <!-- Groups -->
    <record id="group_farmer_user" model="res.groups">
        <field name="name">Farmer User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_farmer_admin" model="res.groups">
        <field name="name">Farmer Admin</field>
        <field name="implied_ids" eval="[(4, ref('farmer_management.group_farmer_user'))]"/>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Record rules: Users see only their own records; Admin unrestricted -->
    <record id="rule_farmer_user_own_farmers" model="ir.rule">
        <field name="name">Farmer User: Own Farmers</field>
        <field name="model_id" ref="model_farmer_management"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('farmer_management.group_farmer_user'))]"/>
    </record>

    <record id="rule_farmer_user_own_lands" model="ir.rule">
        <field name="name">Farmer User: Own Lands</field>
        <field name="model_id" ref="model_farmer_land"/>
        <field name="domain_force">[('farmer_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('farmer_management.group_farmer_user'))]"/>
    </record>

    <record id="rule_farmer_user_own_crops" model="ir.rule">
        <field name="name">Farmer User: Own Crops</field>
        <field name="model_id" ref="model_farmer_crop"/>
        <field name="domain_force">[('land_id.farmer_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('farmer_management.group_farmer_user'))]"/>
    </record>

    <record id="rule_farmer_user_own_family" model="ir.rule">
        <field name="name">Farmer User: Own Family</field>
        <field name="model_id" ref="model_farmer_family"/>
        <field name="domain_force">[('farmer_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('farmer_management.group_farmer_user'))]"/>
    </record>
</odoo>
