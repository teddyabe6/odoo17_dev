<odoo>
    <!-- Farmer Menu -->
    <menuitem id="menu_farmer_root" name="Farmer Management"/>
    <menuitem id="menu_farmer" name="Farmers" parent="menu_farmer_root"/>

    <!-- Farmer Action -->
    <record id="action_farmer" model="ir.actions.act_window">
        <field name="name">Farmers</field>
        <field name="res_model">farmer.management</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_farmer_action" name="Farmers" parent="menu_farmer" action="action_farmer"/>

    <!-- Farmer Form View -->
    <record id="view_farmer_form" model="ir.ui.view">
        <field name="name">farmer.form</field>
        <field name="model">farmer.management</field>
        <field name="arch" type="xml">
            <form string="Farmer">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="age"/>
                        <field name="village"/>
                        <field name="total_land_area" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Lands">
                            <field name="land_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="size_in_hectares"/>
                                    <field name="location"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
